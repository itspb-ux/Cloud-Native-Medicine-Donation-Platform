# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- Database ---
# Option A: single connection string (recommended, e.g. from Supabase/Neon/Render/local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medicine_donation

# Option B: individual fields (used only if DATABASE_URL is not set)
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=medicine_donation
# PGUSER=postgres
# PGPASSWORD=postgres

# --- Background jobs ---
# How often (ms) to re-run the expiry alert scan. Default below = 1 hour.
EXPIRY_CHECK_INTERVAL_MS=3600000

# --- Frontend ---
# Only needed if you move the frontend folder; defaults to ../frontend
# FRONTEND_PATH=frontend
